# ==========================================
# SmartCharge pi-server 環境變數範本
# 使用方式:cp .env.example .env,再填入真實值
# 注意:.env 絕對不要提交到 Git
# ==========================================

# ---- Django ----
# 產生方式:python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=False
# 以逗號分隔,例如樹莓派的區網 IP 或主機名稱
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,raspberrypi.local,192.168.1.100

# ---- 資料庫 ----
# 開發階段先用 SQLite;若改 PostgreSQL 再填下面欄位
DB_ENGINE=sqlite
DB_NAME=db.sqlite3
# DB_USER=smartcharge
# DB_PASSWORD=change-me
# DB_HOST=localhost
# DB_PORT=5432

# ---- MQTT Broker(Mosquitto)----
MQTT_HOST=localhost
MQTT_PORT=1883
# 啟用 TLS 時改用 8883,並設定 MQTT_USE_TLS=True
MQTT_USE_TLS=False
MQTT_USERNAME=smartcharge
MQTT_PASSWORD=change-me
# 每個 client 的 ID 必須唯一,否則會互相踢下線
MQTT_CLIENT_ID=pi-server
# Topic 前綴,需與 docs/mqtt-protocol.md 一致
MQTT_TOPIC_PREFIX=smartcharge

# ---- 其他 ----
TIME_ZONE=Asia/Taipei
